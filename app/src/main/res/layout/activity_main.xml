<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.codex.lle.companion.GraceBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grace_header_background"
            android:elevation="7dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="15dp"
            android:paddingEnd="22dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.10"
                android:text="@string/brand_title"
                android:textColor="@color/lle_grace_navy"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/app_subtitle"
                android:textColor="#414B68"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/companion_label"
                android:textAllCaps="true"
                android:textColor="#596889"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/update_status_section"
                    android:textAllCaps="true"
                    android:textColor="@color/lle_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grace_card_background"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_background"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/status_checking"
                        android:textColor="@color/lle_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/grace_control_row_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/installed_version"
                            android:textColor="@color/lle_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/installedVersionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/unknown"
                            android:textColor="@color/lle_grace_navy"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/grace_control_row_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/available_version"
                            android:textColor="@color/lle_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/availableVersionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/unknown"
                            android:textColor="@color/lle_grace_navy"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lastCheckedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="13dp"
                        android:textColor="@color/lle_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/lle_cyan"
                        app:trackColor="#C6D0DD" />

                    <TextView
                        android:id="@+id/progressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:textColor="@color/lle_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/actionButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/grace_primary_button_background"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:text="@string/install_lle"
                        android:textAllCaps="false"
                        android:textColor="@color/lle_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/checkButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/grace_secondary_button_background"
                        android:backgroundTint="@null"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:minHeight="0dp"
                        android:text="@string/check_updates"
                        android:textAllCaps="false"
                        android:textColor="@color/lle_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/releaseLink"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/release_link"
                        android:textColor="@color/lle_cyan"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/installTutorialLink"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/install_tutorial_link"
                        android:textColor="@color/lle_cyan"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/notification_section"
                    android:textAllCaps="true"
                    android:textColor="@color/lle_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grace_card_background"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <Switch
                        android:id="@+id/notificationSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/grace_control_row_background"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:showText="false"
                        android:splitTrack="false"
                        android:switchMinWidth="50dp"
                        android:text="@string/notify_updates"
                        android:textColor="@color/lle_text"
                        android:textOff="@string/switch_off"
                        android:textOn="@string/switch_on"
                        android:textSize="16sp"
                        android:thumbTint="@color/grace_switch_thumb"
                        android:trackTint="@color/grace_switch_track" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/notify_summary"
                        android:textColor="@color/lle_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:text="@string/footer_text"
                    android:textColor="@color/lle_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
