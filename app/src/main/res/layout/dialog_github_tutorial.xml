<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/grace_card_background"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/github_tutorial_title"
            android:textColor="@color/lle_grace_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/github_tutorial_body"
            android:textColor="@color/lle_text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/tutorialMediaContainer"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="17dp"
            android:background="@drawable/grace_tutorial_media_background">

            <com.codex.lle.companion.LoopingGifView
                android:id="@+id/downloadTutorialGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/github_tutorial_media_description" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/github_tutorial_placeholder_caption"
            android:textColor="@color/lle_text_secondary"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/openGithubButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="17dp"
            android:background="@drawable/grace_primary_button_background"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:text="@string/open_github"
            android:textAllCaps="false"
            android:textColor="@color/lle_cyan"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelTutorialButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/grace_secondary_button_background"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:text="@string/not_now"
            android:textAllCaps="false"
            android:textColor="@color/lle_text_secondary"
            android:textSize="14sp"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
