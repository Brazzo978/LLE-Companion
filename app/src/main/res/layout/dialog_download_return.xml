<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/grace_card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="@string/download_return_title"
        android:textColor="@color/lle_grace_navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/download_return_body"
        android:textColor="@color/lle_text_secondary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/showInstallTutorialButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/grace_primary_button_background"
        android:backgroundTint="@null"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:text="@string/show_install_tutorial"
        android:textAllCaps="false"
        android:textColor="@color/lle_cyan"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/downloadNotReadyButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/grace_secondary_button_background"
        android:backgroundTint="@null"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:text="@string/not_yet"
        android:textAllCaps="false"
        android:textColor="@color/lle_text_secondary"
        android:textSize="14sp"
        app:backgroundTint="@null" />
</LinearLayout>
