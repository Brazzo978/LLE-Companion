<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E1F4F4" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#6450AAAF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFFF" android:endColor="#E1F8F7" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#6464B1B5" />
        </shape>
    </item>
</selector>
